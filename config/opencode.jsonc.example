{
  "$schema": "https://opencode.ai/config.json",
  //"model": "anthropic/claude-opus-4-6",
  "model": "opencode-go/deepseek-v4.1-flash",
  "mcp": {
    "servers": {
      "mcp-clickhouse": {
        "type": "local",
        "command": [
          "/root/.local/bin/uv",
          "run",
          "--with",
          "mcp-clickhouse",
          "--python",
          "3.10",
          "mcp-clickhouse"
        ],
        "environment": {
          "CLICKHOUSE_HOST": "{env:CLICKHOUSE_HOST}",
          "CLICKHOUSE_PORT": "{env:CLICKHOUSE_PORT}",
          "CLICKHOUSE_USER": "{env:CLICKHOUSE_USER}",
          "CLICKHOUSE_PASSWORD": "{env:CLICKHOUSE_PASSWORD}",
          "CLICKHOUSE_SECURE": "false",
          "CLICKHOUSE_VERIFY": "false",
          "CLICKHOUSE_CONNECT_TIMEOUT": "30",
          "CLICKHOUSE_SEND_RECEIVE_TIMEOUT": "30"
        }
      }
    }
  },
  "permissions": [
    // Deny everything write-related. Rules are ordered and the last match wins.
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "question", "resource": "*", "effect": "deny" },

    // Basic file permissions
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },

    // Allow web fetching
    //{ "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },

    // Allow skills
    { "action": "skill", "resource": "*", "effect": "allow" },

    /*
    // Allow specific MCP tools for the clickhouse server
    { "action": "mcp-clickhouse_list_databases", "resource": "*", "effect": "allow" },
    { "action": "mcp-clickhouse_list_tables", "resource": "*", "effect": "allow" },
    { "action": "mcp-clickhouse_run_select_query", "resource": "*", "effect": "allow" },
    */

    // No access to external directories
    { "action": "external_directory", "resource": "*", "effect": "deny" },
  ],
  "agents": {
    "build": {
      // The built-in build agent appends a rule allowing `question`; re-deny it
      // last so the bot never blocks waiting for an interactive answer.
      "permissions": [
        { "action": "question", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
