# Set your provider key here as you would elsewhere
ANTHROPIC_API_KEY=sk-ant-...
OPENCODE_API_KEY=sk-...

# Slack setup - see README.md
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Comma-separated Slack user IDs whose requests are rejected (blank = allow everyone)
# To get a user's ID: open their profile in Slack -> "More" (three dots) -> "Copy member ID"
# (e.g. U0123ABCDEF)
BLOCKED_USERS=

# Whether to broadcast replies into the channel (true) or keep them in-thread only (false)
REPLY_BROADCAST=true

# Whether to reject requests from users outside the bot's own workspace (e.g. Slack Connect)
RESTRICT_TO_WORKSPACE=true

# Max size in bytes for files the agent may send back via <slack-file> directives (0 = disabled)
# Default 52428800 = 50 MiB
SEND_FILE_MAX_SIZE=52428800

# Anything else gets passed through to MCPs
CLICKHOUSE_HOST=...
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=...
CLICKHOUSE_PASSWORD=...
